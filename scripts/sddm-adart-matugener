#!/usr/bin/env bash
# %name: sddm-adart-matugener
# %desc: Install a Matugen-generated AD/Art Matugen override for the SDDM astronaut theme
# %icon: preferences-desktop-theme
# %terminal: true
# %categories: system,theme,sddm,matugen
# %mode: cli
# %tags: sddm,matugen,astronaut,theme,login-manager
#
# @packageDocumentation
# Copies a generated SDDM astronaut theme override into the root-owned theme directory.
# Designed as a Matugen post_hook target, because Matugen should not need to be run as root.
#
# Default source:
#   ~/.cache/matugen/sddm-astronaut-theme.conf.user
#
# Default target:
#   /usr/share/sddm/themes/sddm-astronaut-theme/theme.conf.user

set -euo pipefail

theme_name="sddm-astronaut-theme"
theme_root="/usr/share/sddm/themes"
source_file="${XDG_CACHE_HOME:-$HOME/.cache}/matugen/sddm-astronaut-theme.conf.user"
preview=false

usage() {
  cat <<'EOF'
Usage:
  sddm-adart-matugener [options]

Options:
  --source FILE       Source override file generated by Matugen.
  --theme-name NAME   SDDM theme name. Default: sddm-astronaut-theme
  --theme-root DIR    SDDM theme root. Default: /usr/share/sddm/themes
  --preview           Preview the theme after installing.
  -h, --help          Show this help.

Example Matugen post_hook:
  ~/.local/bin/matugen-sddm-astronaut-install --preview
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --source)
      source_file="${2:?Missing value for --source}"
      shift 2
      ;;
    --theme-name)
      theme_name="${2:?Missing value for --theme-name}"
      shift 2
      ;;
    --theme-root)
      theme_root="${2:?Missing value for --theme-root}"
      shift 2
      ;;
    --preview)
      preview=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

theme_dir="${theme_root}/${theme_name}"
target_file="${theme_dir}/theme.conf.user"

if [[ ! -d "$theme_dir" ]]; then
  echo "Theme directory not found: $theme_dir" >&2
  echo "Try: pacman -Qo /usr/share/sddm/themes/sddm-astronaut-theme" >&2
  exit 1
fi

if [[ ! -f "$source_file" ]]; then
  echo "Generated Matugen file not found: $source_file" >&2
  exit 1
fi

echo "Installing SDDM astronaut Matugen override:"
echo "  from: $source_file"
echo "  to:   $target_file"

sudo install -Dm644 "$source_file" "$target_file"

echo "Installed."

if [[ "$preview" == true ]]; then
  if command -v sddm-greeter-qt6 >/dev/null 2>&1; then
    sddm-greeter-qt6 --test-mode --theme "$theme_dir"
  elif command -v sddm-greeter >/dev/null 2>&1; then
    sddm-greeter --test-mode --theme "$theme_dir"
  else
    echo "No sddm-greeter preview command found." >&2
    echo "Try installing/checking SDDM Qt6 greeter tools." >&2
  fi
fi
